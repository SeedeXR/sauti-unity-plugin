{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sauti.dev/schemas/knowledge-feed.schema.json",
  "title": "Knowledge Feed (Bulk Ingestion)",
  "description": "Bulk format for feeding documents into the RAG knowledge base. Each entry becomes one or more 384-dim chunks in the offline-built knowledge.db. Consumed by the Editor build tool described in voice_ai_architecture.md § 4.4.",
  "type": "object",
  "required": ["templateId", "templateVersion", "feedId", "documents"],
  "properties": {
    "templateId": { "type": "string", "const": "knowledge-feed" },
    "templateVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string", "maxLength": 280 },
    "feedId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "language": { "type": "string", "const": "en", "default": "en", "description": "v1.2 is English-only." },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["docId", "title", "body"],
        "properties": {
          "docId": {
            "type": "string",
            "pattern": "^(\\$\\{[A-Z_][A-Z0-9_]*\\}|[a-z0-9][a-z0-9_-]*)$",
            "minLength": 1,
            "maxLength": 80,
            "description": "Lowercase kebab/snake id. Accepts ${VAR_NAME} placeholder in templates."
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "body": {
            "type": "string",
            "minLength": 1,
            "description": "Plain text. The build tool chunks this at paragraph boundaries (~200 tokens each)."
          },
          "tags": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "pattern": "^(\\$\\{[A-Z_][A-Z0-9_]*\\}|[a-z0-9][a-z0-9_-]*)$",
              "maxLength": 40
            },
            "description": "Optional tags used for retrieval-score boosting / filtering."
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri",
            "description": "Optional provenance URL — not embedded into the chunk, only logged."
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "templateId": "knowledge-feed",
      "templateVersion": "1.0.0",
      "description": "Stormwall starter lore.",
      "feedId": "stormwall_lore",
      "language": "en",
      "documents": [
        {
          "docId": "crystal_caverns",
          "title": "The Crystal Caverns",
          "body": "The Crystal Caverns lie north of Stormwall, hidden beneath the frozen lake. Few have entered and fewer have returned.",
          "tags": ["location", "lore", "danger"]
        }
      ]
    }
  ]
}
