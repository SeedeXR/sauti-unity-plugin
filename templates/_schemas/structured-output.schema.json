{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sauti.dev/schemas/structured-output.schema.json",
  "title": "Structured LLM Output (Tool / Action Schema)",
  "description": "Shape an LLM response must take when invoking a game-side action. The runtime validates the LLM's JSON output against this schema before dispatching to the Event Bus. Lets the LLM trigger deterministic game mechanics instead of free-text only.",
  "type": "object",
  "required": ["templateId", "templateVersion", "schemaId", "actions"],
  "properties": {
    "templateId": { "type": "string", "const": "structured-output" },
    "templateVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string", "maxLength": 280 },
    "schemaId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "strict": {
      "type": "boolean",
      "default": true,
      "description": "When true, the runtime rejects any output that does not match an action's schema exactly. When false, unknown fields are dropped silently."
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "parameters"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^(\\$\\{[A-Z_][A-Z0-9_]*\\}|[a-z][a-z0-9_]*)$",
            "minLength": 1,
            "maxLength": 64,
            "description": "Function name the LLM emits. Lower-snake-case. Accepts ${VAR_NAME} placeholder in templates."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "What the action does, written for the LLM to read."
          },
          "parameters": {
            "type": "object",
            "description": "JSON-Schema-like description of each named parameter.",
            "required": ["type", "properties"],
            "properties": {
              "type": { "type": "string", "const": "object" },
              "properties": { "type": "object" },
              "required": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "templateId": "structured-output",
      "templateVersion": "1.0.0",
      "description": "Inventory management actions the LLM may invoke.",
      "schemaId": "inventory_actions",
      "strict": true,
      "actions": [
        {
          "name": "give_item",
          "description": "Place an item into the player's inventory.",
          "parameters": {
            "type": "object",
            "properties": {
              "itemId": { "type": "string" },
              "quantity": { "type": "integer", "minimum": 1, "maximum": 99, "default": 1 }
            },
            "required": ["itemId"]
          }
        }
      ]
    }
  ]
}
